<Window x:Class="SysDiag.Ui.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        SizeToContent="Height" Width="620" ResizeMode="NoResize" MaxHeight="700"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Border Background="{StaticResource BSurface}" BorderBrush="{StaticResource BStroke}"
          BorderThickness="1" CornerRadius="8" Padding="26,24,26,20">
    <StackPanel>
      <TextBlock Text="Qué limpiar" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,18"
                 Text="Primero se calcula cuánto ocupa cada destino y después se pide confirmación. Nada se borra en este paso."/>

      <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Lista"/>
      </ScrollViewer>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="Cancelar" Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Click="Cancelar_Click"/>
        <Button Content="Analizar" Style="{StaticResource BtnPrimary}" Click="Aceptar_Click" IsDefault="True"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
