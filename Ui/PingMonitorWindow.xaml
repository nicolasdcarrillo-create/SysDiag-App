<Window x:Class="SysDiag.Ui.PingMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitor de ping" Height="560" Width="820" MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BBase}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Monitor de ping" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0"
                 Text="Ping cada segundo mientras esta ventana esté abierta. Útil para ver si un pico de lag coincide con algo puntual (otro dispositivo descargando, el ventilador acelerando, etc.)."/>
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <ComboBox x:Name="ComboDestino" Grid.Column="0" Width="280" HorizontalAlignment="Left"/>
      <Button x:Name="BtnIniciar" Grid.Column="1" Content="Iniciar" Style="{StaticResource BtnPrimary}"
              Click="Toggle_Click"/>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource Card}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="ACTUAL" Style="{StaticResource Eyebrow}"/>
            <TextBlock x:Name="TxtActual" Text="—" FontFamily="{StaticResource FDisplay}" FontSize="28" Foreground="{StaticResource BAccent}"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="PROMEDIO" Style="{StaticResource Eyebrow}"/>
            <TextBlock x:Name="TxtPromedio" Text="—" FontFamily="{StaticResource FDisplay}" FontSize="28" Foreground="{StaticResource BText}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="MÁXIMO" Style="{StaticResource Eyebrow}"/>
            <TextBlock x:Name="TxtMaximo" Text="—" FontFamily="{StaticResource FDisplay}" FontSize="28" Foreground="{StaticResource BWarn}"/>
          </StackPanel>
          <StackPanel Grid.Column="3">
            <TextBlock Text="PÉRDIDA" Style="{StaticResource Eyebrow}"/>
            <TextBlock x:Name="TxtPerdida" Text="—" FontFamily="{StaticResource FDisplay}" FontSize="28" Foreground="{StaticResource BBad}"/>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
          <!-- Franjas de referencia: dan escala al ojo sin números en cada línea. -->
          <Canvas x:Name="Lienzo" ClipToBounds="True">
            <Line X1="0" Y1="0" X2="0" Y2="0" x:Name="LineaTope" Stroke="{StaticResource BStrokeSoft}" StrokeThickness="1"/>
            <Line X1="0" Y1="0" X2="0" Y2="0" x:Name="LineaMedio" Stroke="{StaticResource BStrokeSoft}" StrokeThickness="1"/>
            <Line X1="0" Y1="0" X2="0" Y2="0" x:Name="LineaBase" Stroke="{StaticResource BStroke}" StrokeThickness="1"/>
            <Polygon x:Name="Area" Fill="{StaticResource BAccentWash}"/>
            <Polyline x:Name="Linea" Stroke="{StaticResource BAccent}" StrokeThickness="2" StrokeLineJoin="Round"/>
          </Canvas>
          <TextBlock x:Name="TxtVacio" Style="{StaticResource Dim}" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Text="Elegí un destino y tocá Iniciar."/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
