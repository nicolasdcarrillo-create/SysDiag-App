<Window x:Class="SysDiag.Ui.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        SizeToContent="Height" Width="470" ResizeMode="NoResize" MaxHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Border Background="{StaticResource BSurface}" BorderBrush="{StaticResource BStroke}"
          BorderThickness="1" CornerRadius="8" Padding="26,24,26,20">
    <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Top">
        <Rectangle x:Name="Acento" Height="3" Width="44" HorizontalAlignment="Left"
                   RadiusX="2" RadiusY="2" Fill="{StaticResource BAccent}" Margin="0,0,0,16"/>
        <TextBlock x:Name="Titulo" Style="{StaticResource H1}" TextWrapping="Wrap"/>
      </StackPanel>

      <StackPanel x:Name="Botones" DockPanel.Dock="Bottom" Orientation="Horizontal"
                  HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource BtnGhost}"
                Margin="0,0,8,0" Click="Cancelar_Click" Visibility="Collapsed"/>
        <Button x:Name="BtnAceptar" Content="Entendido" Style="{StaticResource BtnPrimary}"
                Click="Aceptar_Click" IsDefault="True"/>
      </StackPanel>

      <!-- El cuerpo es lo único de largo variable: un resultado de
           instalación de drivers o un log de reparación puede ser varios
           párrafos. Con tope y scroll propio, nunca empuja los botones
           fuera de la pantalla. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,-14,0" Padding="0,0,14,0">
        <TextBlock x:Name="Cuerpo" Style="{StaticResource Body}" TextWrapping="Wrap"
                   Foreground="{StaticResource BTextDim}"/>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
