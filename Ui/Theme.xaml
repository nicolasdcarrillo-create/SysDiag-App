<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- ================================================================
       Tokens de color. Base azul-pizarra, no negro puro: da profundidad
       por elevación de superficie en vez de por bordes marcados.
       ================================================================ -->
  <Color x:Key="CBase">#FF0E1116</Color>
  <Color x:Key="CSidebar">#FF0A0C10</Color>
  <Color x:Key="CSurface">#FF161B22</Color>
  <Color x:Key="CSurfaceAlt">#FF1D232D</Color>
  <Color x:Key="CStroke">#FF2A323D</Color>
  <Color x:Key="CStrokeSoft">#FF20262F</Color>
  <Color x:Key="CText">#FFE5E9EF</Color>
  <Color x:Key="CTextDim">#FF98A2B2</Color>
  <Color x:Key="CTextMuted">#FF68727F</Color>
  <Color x:Key="CAccent">#FF6C7BF7</Color>
  <Color x:Key="COk">#FF46B98A</Color>
  <Color x:Key="CWarn">#FFE0A33F</Color>
  <Color x:Key="CBad">#FFE05C6B</Color>

  <SolidColorBrush x:Key="BBase" Color="{StaticResource CBase}"/>
  <SolidColorBrush x:Key="BSidebar" Color="{StaticResource CSidebar}"/>
  <SolidColorBrush x:Key="BSurface" Color="{StaticResource CSurface}"/>
  <SolidColorBrush x:Key="BSurfaceAlt" Color="{StaticResource CSurfaceAlt}"/>
  <SolidColorBrush x:Key="BStroke" Color="{StaticResource CStroke}"/>
  <SolidColorBrush x:Key="BStrokeSoft" Color="{StaticResource CStrokeSoft}"/>
  <SolidColorBrush x:Key="BText" Color="{StaticResource CText}"/>
  <SolidColorBrush x:Key="BTextDim" Color="{StaticResource CTextDim}"/>
  <SolidColorBrush x:Key="BTextMuted" Color="{StaticResource CTextMuted}"/>
  <SolidColorBrush x:Key="BAccent" Color="{StaticResource CAccent}"/>
  <SolidColorBrush x:Key="BOk" Color="{StaticResource COk}"/>
  <SolidColorBrush x:Key="BWarn" Color="{StaticResource CWarn}"/>
  <SolidColorBrush x:Key="BBad" Color="{StaticResource CBad}"/>
  <SolidColorBrush x:Key="BAccentWash" Color="#FF6C7BF7" Opacity="0.14"/>
  <SolidColorBrush x:Key="BHover" Color="#FFFFFFFF" Opacity="0.05"/>

  <!-- ================================================================
       Tipografía en tres roles. Bahnschrift es un DIN: la letra del
       dibujo técnico y la señalética de ingeniería. Cascadia Mono lleva
       cifras tabulares, así las columnas de números no bailan.
       ================================================================ -->
  <!-- Escala de espaciado sobre base de 8: los valores dejan de ser
       arbitrarios y el ritmo vertical se mantiene entre vistas. -->
  <Thickness x:Key="S1">8</Thickness>
  <Thickness x:Key="S2">16</Thickness>
  <Thickness x:Key="S3">24</Thickness>
  <Thickness x:Key="CardPad">20,18,20,18</Thickness>
  <CornerRadius x:Key="RSm">4</CornerRadius>
  <CornerRadius x:Key="RMd">8</CornerRadius>

  <FontFamily x:Key="FDisplay">Bahnschrift SemiCondensed, Bahnschrift, Segoe UI Semibold, Segoe UI</FontFamily>
  <FontFamily x:Key="FBody">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="FMono">Cascadia Mono, Consolas, Courier New</FontFamily>

  <Style x:Key="Eyebrow" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FDisplay}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{StaticResource BTextMuted}"/>
  </Style>

  <Style x:Key="Metric" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FDisplay}"/>
    <Setter Property="FontSize" Value="30"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FDisplay}"/>
    <Setter Property="FontSize" Value="21"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
  </Style>

  <Style x:Key="Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
  </Style>

  <Style x:Key="Dim" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource BTextDim}"/>
  </Style>

  <Style x:Key="Mono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FMono}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
  </Style>

  <!-- ================================================================
       Barra de desplazamiento. WPF la trae clara por defecto; retemplada
       queda fina y sin flechas, para no competir con el contenido.
       ================================================================ -->
  <!-- Sombra de tarjeta: deliberadamente sutil. Un blur grande y opacidad
       alta sobre un fondo ya oscuro se ve sucio, no elegante; esto solo
       separa la tarjeta del fondo un par de píxeles. -->
  <DropShadowEffect x:Key="CardShadow" Color="Black" Direction="270"
                    ShadowDepth="2" BlurRadius="10" Opacity="0.35"/>

  <!-- Superficie base de tarjeta. El borde de 1px sobre fondo oscuro define
       el canto; la sombra añade la separación de profundidad. -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStrokeSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RMd}"/>
    <Setter Property="Padding" Value="{StaticResource CardPad}"/>
    <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
  </Style>

  <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource BStroke}"/>
        <Setter Property="Background" Value="{StaticResource BSurfaceAlt}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Rótulo de sección: versalita con regla, para separar bloques sin
       recurrir a más cajas anidadas. -->
  <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
    <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>

  <!-- Distintivo de severidad: fondo tenue del mismo tono que el texto. -->
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource RSm}"/>
    <Setter Property="Padding" Value="8,3"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="#FF39424F" CornerRadius="3" Margin="3,0"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Height" Value="10"/>
              <Setter Property="Width" Value="Auto"/>
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       Botones
       ================================================================ -->
  <Style x:Key="BtnBase" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
    <Setter Property="Padding" Value="16,9"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BAccent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="{StaticResource BAccent}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BAccent}"/>
    <Setter Property="Foreground" Value="#FF0B0E14"/>
  </Style>

  <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStroke}"/>
  </Style>

  <Style x:Key="BtnCaption" TargetType="Button">
    <Setter Property="Width" Value="44"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Foreground" Value="{StaticResource BTextDim}"/>
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Cursor" Value="Arrow"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BHover}"/>
              <Setter Property="Foreground" Value="{StaticResource BText}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Conmutador de vistas: pastillas segmentadas en la cabecera -->
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{StaticResource BTextDim}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="14,6">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BHover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BSurfaceAlt}"/>
              <Setter Property="Foreground" Value="{StaticResource BText}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       Navegación lateral. Es un ListBox y no botones sueltos: así el
       módulo activo queda marcado solo, sin estado que sincronizar.
       ================================================================ -->
  <Style x:Key="NavItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="Bd" Background="Transparent" Padding="20,10"/>
            <Rectangle x:Name="Mark" Width="3" RadiusX="2" RadiusY="2" Margin="0,6"
                       HorizontalAlignment="Left"
                       Fill="{StaticResource BAccent}" Visibility="Collapsed"/>
            <ContentPresenter Margin="20,10" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BAccentWash}"/>
              <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NavGroup" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
    <Setter Property="Margin" Value="20,18,20,6"/>
    <Setter Property="FontSize" Value="10"/>
  </Style>

  <Style x:Key="NavIcon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Width" Value="24"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{StaticResource BTextMuted}"/>
  </Style>

  <!-- La plantilla nativa del ListBox pinta el fondo del sistema (blanco)
       cuando el control está deshabilitado, que es justo lo que pasa mientras
       corre un módulo. Se reemplaza entera para que no quede ningún camino
       por el que se cuele un color que no sea de la paleta. -->
  <Style x:Key="PlainList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="Transparent" BorderThickness="0">
            <ScrollViewer Focusable="False" Padding="0" Background="Transparent">
              <ItemsPresenter SnapsToDevicePixels="True"/>
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Fila de hallazgo -->
  <Style x:Key="FindingItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource BStrokeSoft}"
                  BorderThickness="0,0,0,1">
            <ContentPresenter Margin="0"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BSurfaceAlt}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       ComboBox retemplado por completo: el nativo despliega en blanco.
       ================================================================ -->
  <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
    <Border Background="{StaticResource BSurfaceAlt}" BorderBrush="{StaticResource BStroke}"
            BorderThickness="1" CornerRadius="4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="28"/>
        </Grid.ColumnDefinitions>
        <ContentPresenter Grid.Column="0" Margin="12,0,0,0" VerticalAlignment="Center"
                          Content="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
        <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
              Data="M0,0 L8,0 L4,5 Z" Fill="{StaticResource BTextDim}"/>
      </Grid>
    </Border>
  </ControlTemplate>

  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Template="{StaticResource ComboToggle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          Focusable="False" ClickMode="Press"/>
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                   AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
              <Border Background="{StaticResource BSurfaceAlt}" BorderBrush="{StaticResource BStroke}"
                      BorderThickness="1" CornerRadius="4" Margin="0,4,0,0"
                      MinWidth="{TemplateBinding ActualWidth}">
                <ScrollViewer MaxHeight="320">
                  <StackPanel IsItemsHost="True"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BAccentWash}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       DataGrid: sin líneas verticales, cabecera discreta, datos en mono.
       ================================================================ -->
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource BBase}"/>
    <Setter Property="Foreground" Value="{StaticResource BTextMuted}"/>
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStroke}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DataGridCell">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
    <Setter Property="FontFamily" Value="{StaticResource FMono}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="12,7"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DataGridRow">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStrokeSoft}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource BHover}"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource BAccentWash}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="RowBackground" Value="Transparent"/>
    <Setter Property="GridLinesVisibility" Value="None"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="AutoGenerateColumns" Value="True"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserDeleteRows" Value="False"/>
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="SelectionUnit" Value="FullRow"/>
    <Setter Property="EnableRowVirtualization" Value="True"/>
    <Setter Property="ColumnWidth" Value="Auto"/>
    <Setter Property="RowHeaderWidth" Value="0"/>
  </Style>

  <!-- Barra de progreso indeterminada propia: la nativa ignora el color -->
  <Style x:Key="Pulse" TargetType="ProgressBar">
    <Setter Property="Height" Value="2"/>
    <Setter Property="IsIndeterminate" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="Root" Background="{StaticResource BStrokeSoft}" ClipToBounds="True">
            <Border x:Name="Bar" Background="{StaticResource BAccent}" Width="140"
                    HorizontalAlignment="Left">
              <Border.RenderTransform>
                <TranslateTransform x:Name="Slide" X="-140"/>
              </Border.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="Anim">
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X"
                                     From="-140" To="900" Duration="0:0:1.4"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="Anim"/>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Casilla de opción con franja de riesgo, compartida por los diálogos
       de limpieza y optimización. -->
  <Style x:Key="Opcion" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="14,12" Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Rectangle Grid.Column="0" Width="3" RadiusX="2" RadiusY="2"
                         Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
              <Border x:Name="Box" Grid.Column="1" Width="17" Height="17" CornerRadius="3"
                      BorderBrush="{StaticResource BStroke}" BorderThickness="1.5"
                      VerticalAlignment="Top" Margin="12,1,0,0" Background="Transparent">
                <Path x:Name="Tick" Data="M0,4 L3,7 L9,0" Stroke="#FF0B0E14" StrokeThickness="2"
                      Stretch="None" Margin="3,4,0,0" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="2" Margin="12,0,0,0"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BHover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource BAccent}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BAccent}"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Gráfico de barras. Etiqueta a la izquierda, barra al centro y cifra a
       la derecha: se puede leer por columnas o comparar longitudes de un
       vistazo, sin tener que interpretar ejes. -->
  <DataTemplate x:Key="BarTemplate">
    <Grid Margin="0,0,0,9" ToolTip="{Binding Detalle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="{Binding Etiqueta}" Style="{StaticResource Dim}"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/>
      <Rectangle Grid.Column="1" Height="16" RadiusX="3" RadiusY="3"
                 HorizontalAlignment="Left" Fill="{Binding Color}" Width="{Binding Ancho}"/>
      <TextBlock Grid.Column="2" Text="{Binding ValorTexto}" FontFamily="{StaticResource FMono}"
                 FontSize="12" Foreground="{Binding Color}" VerticalAlignment="Center"
                 Margin="14,0,0,0"/>
    </Grid>
  </DataTemplate>

  <Style TargetType="ToolTip">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{StaticResource BSurfaceAlt}" BorderBrush="{StaticResource BStroke}"
                  BorderThickness="1" CornerRadius="4" Padding="10,6">
            <ContentPresenter TextBlock.Foreground="{StaticResource BText}"
                              TextBlock.FontFamily="{StaticResource FBody}"
                              TextBlock.FontSize="12"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
